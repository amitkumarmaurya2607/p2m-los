  "item": [
    {
      "name": "01. Auth",
      "item": [
        {
          "name": "Send OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "if (json.data?.userId) {",
                  "  pm.collectionVariables.set('userId', json.data.userId);",
                  "  console.log('[auth] userId saved:', json.data.userId);",
                  "}",
                  "if (json.data?.id) {",
                  "  pm.collectionVariables.set('userId', json.data.id);",
                  "  console.log('[auth] userId saved (from id):', json.data.id);",
                  "}",
                  "if (json.data?.mobileNumber) {",
                  "  pm.collectionVariables.set('mobileNumber', json.data.mobileNumber);",
                  "}",
                  "if (json.code === '0001') {",
                  "  console.warn('[auth] Send OTP failed:', json.message || json.msg);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobileNumber\": \"{{mobileNumber}}\",\n  \"brandId\": \"{{orgId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/los-service/api/web-proxy/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["los-service", "api", "web-proxy", "send-otp"]
            },
            "description": "Send OTP to the user's mobile number. The test script captures `userId` from the response for the Verify OTP step."
          }
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "if (json.data?.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  console.log('[auth] accessToken updated successfully');",
                  "  try {",
                  "    const parts = json.data.accessToken.split('.');",
                  "    if (parts.length === 3) {",
                  "      const payload = JSON.parse(pm.environment.replaceIn(Buffer.from(parts[1], 'base64url').toString('utf8')));",
                  "      if (payload.exp) {",
                  "        const expiresAt = new Date(payload.exp * 1000);",
                  "        console.log(`[auth] New token expires at ${expiresAt.toISOString()}`);",
                  "      }",
                  "    }",
                  "  } catch (e) {}",
                  "}",
                  "if (json.data?.user?.id) {",
                  "  pm.collectionVariables.set('userId', json.data.user.id);",
                  "  console.log('[auth] userId saved:', json.data.user.id);",
                  "}",
                  "if (json.code === '0001') {",
                  "  console.warn('[auth] OTP verification failed:', json.message || json.msg);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobileNumber\": \"{{mobileNumber}}\",\n  \"userId\": \"{{userId}}\",\n  \"otp\": \"{{otp}}\",\n  \"type\": \"MOBILE_NUM_VERIFY\",\n  \"deviceId\": \"{{deviceId}}\",\n  \"brandId\": \"{{orgId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/los-service/api/web-proxy/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["los-service", "api", "web-proxy", "verify-otp"]
            },
            "description": "Verify the OTP. Test script captures `accessToken` and `userId` from the response; the new token is automatically applied to all subsequent requests via the collection-level Bearer auth."
          }
        }
      ]
    },
