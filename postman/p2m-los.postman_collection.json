            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{firstName}} {{lastName}}\",\n  \"email\": \"{{emailId}}\",\n  \"message\": \"Submitted from Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/contact/submit",
              "host": ["{{baseUrl}}"],
              "path": ["contact", "submit"]
            },
            "description": "Submit the public Contact-Us form on the marketing site. No auth required. Note: this path is NOT under `/los-service`."
          }
        }
      ]
    }
  ]
}
